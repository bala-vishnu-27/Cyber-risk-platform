{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "GitHub CodeQL / Dependency Reviewer",
          "rules": [
            {
              "id": "CVE-2021-44228",
              "name": "log4j-core",
              "shortDescription": { "text": "Apache Log4j2 JNDI Remote Code Execution (Log4Shell)" },
              "properties": { "security-severity": "10.0" }
            },
            {
              "id": "CVE-2022-22965",
              "name": "spring-framework",
              "shortDescription": { "text": "Spring Framework RCE via DataBinder parameter binding (Spring4Shell)" },
              "properties": { "security-severity": "9.8" }
            },
            {
              "id": "CVE-2020-14343",
              "name": "pyyaml",
              "shortDescription": { "text": "PyYAML Arbitrary Code Execution via FullLoader" },
              "properties": { "security-severity": "8.8" }
            },
            {
              "id": "CVE-2020-7692",
              "name": "axios",
              "shortDescription": { "text": "Axios Server-Side Request Forgery vulnerability" },
              "properties": { "security-severity": "7.2" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2021-44228",
          "level": "error",
          "message": { "text": "Critical vulnerability CVE-2021-44228 detected in log4j-core:2.14.1." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "pom.xml" }
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2022-22965",
          "level": "error",
          "message": { "text": "Critical vulnerability CVE-2022-22965 detected in spring-framework:5.3.0." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "pom.xml" }
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2020-14343",
          "level": "error",
          "message": { "text": "High severity flaw CVE-2020-14343 detected in pyyaml:5.3.1." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "requirements.txt" }
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2020-7692",
          "level": "warning",
          "message": { "text": "SSRF finding CVE-2020-7692 in axios:0.21.0." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "package.json" }
              }
            }
          ]
        }
      ]
    }
  ]
}
